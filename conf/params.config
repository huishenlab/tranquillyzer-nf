// conf/params.config

params {

  /*
   * UX / meta
   */
  help    = false
  version = false

  /*
   * ETL behavior
   */
  cleanup_transform = false

  /*
   * Required inputs
   */
  samplesheet = null
  reference   = null
  outdir      = './results'

  /*
   * Optional inputs
   */
  gtf = null

  /*
   * Container configuration
   */

  container_trq = 'varishenlab/tranquillyzer:tranquillyzer_v1.0.1_tf2.15.0'
  image_dir     = "${baseDir}/container_images"

  /*
   * GPU toggles + optional scheduler flags
   */
  enable_gpu     = false
  slurm_gpu_opts = ''

  /*
   * Apptainer/Singularity GPU library support (site-specific; leave empty in repo)
   * Override via:
   *   - command line: --cuda_lib_dir ... --container_binds ...
   *   - a site config: conf/site/<cluster>.config
   */
  gpus                = 1
  cuda_lib_dir        = ""
  container_binds         = []
  container_extra_opts = ''

  /*
   * SLURM defaults (used by slurm profile)
   */
  // slurm_queue = null
  slurm_gpu_queue = null
  slurm_cpu_queue = null
  slurm_time  = '24h'
  slurm_cpus  = 8
  slurm_mem   = null

  /*
   * Cloud scaffolding (used by profiles)
   */
  workDir       = null
  aws_region    = null
  aws_gpu_queue = null
  aws_cpu_queue = null
  gcp_project   = null
  gcp_region    = null
  azure_account = null
  azure_region  = null
  k8s_namespace = 'default'

  /*
   * Throttling / concurrency
   */
  queueSize               = 10

  preprocess_maxForks        = 1
  readlengthdist_maxForks    = 1
  annotate_maxForks          = 1
  generate_whitelist_maxForks = 1
  barcode_correct_maxForks   = 1
  align_maxForks             = 1
  dedup_maxForks             = 1
  splitbam_maxForks          = 1
  featurecounts_maxForks     = 1
  qc_metrics_maxForks        = 1
  fetch_models_maxForks      = 2

  /*
   * Pipeline toggles
   */
  split_bam     = true
  featurecounts = true
  qc_metrics    = true

  /*
   * Model bundles (auto-download)
   *
   * Tranquillyzer v1.0.0+ containers no longer ship default model bundles. On the
   * first run, the pipeline reads the canonical registry `utils/seq_orders.yaml`
   * from inside the container, then ensures every listed model (except those in
   * `skip_template_models`) is materialized under `models_dir/<model_name>/` as the
   * three required files: model.h5, lbl_bin.pkl, params.yaml. Missing files are
   * downloaded from `model_url_base/<model_name>/<filename>`. Subsequent runs are
   * no-ops because the cache lives under the pipeline directory and persists.
   *
   * Users who train their own models can register one or more custom registries
   * via `custom_model_registries`. Each entry is a `[seq_orders: <host file>,
   * models_dir: <host dir>]` pair; the pipeline validates the listed files and
   * symlinks them into `models_dir` so a single `--models-dir` covers both default
   * and user models for the downstream tranquillyzer subcommands.
   *
   *   custom_model_registries = [
   *     [ seq_orders: '/path/to/my/seq_orders.yaml', models_dir: '/path/to/my/models' ]
   *   ]
   */
  models_dir                  = "${baseDir}/models"
  model_url_base              = 'https://www.dropbox.com/scl/fo/3lms8n97bnufzqa4ausv9/AGkO3EVrL1ZgctwEwTK1mEA?rlkey=47m69a6smwsisdznbwu3jvjpu&dl=0'
  // Absolute path inside the tranquillyzer container. The upstream source tree
  // is COPYed to /app/ (not pip-installed under site-packages), so the registry
  // sits at /app/utils/seq_orders.yaml. Override only if upstream relocates.
  seq_orders_in_container_path = '/app/utils/seq_orders.yaml'
  custom_model_registries     = []
  // Names in seq_orders.yaml to exclude from the fetch (and from custom-registry
  // consolidation). The upstream registry currently uses 'template_model'; the
  // bare 'template' is kept for forward-compat with future renames.
  skip_template_models        = ['template_model', 'template']

  /*
   * Whitelist filename produced by `tranquillyzer generate-whitelist`.
   * Kept configurable because the upstream default may evolve; the file lives
   * at <work>/results/<sample>/annotation_metadata/<filename> alongside
   * barcode_counts.tsv, barcode_discovery_stats.json, and barcode_rank_plot.png.
   * BARCODE_CORRECT and LOAD_RESULTS both pick it up from there.
   */
  whitelist_filename = 'discovered_whitelist.tsv'

  /*
   * Tool options
   */
  preprocess_opts = '--output-base-qual --threads 2'

  annotate_reads_opts = [
    '--output-fmt fastq',
    '--model-name 10x3p_sc_ont_016',
    '--chunk-size 300000',
    '--bc-lv-threshold 2',
    '--threads 2'
  ].join(' ')

  generate_whitelist_opts = '--min-reads-per-barcode 3 --min-cell-ratio 0.50'

  barcode_correct_opts = [
    '--output-fmt fastq',
    '--bc-lv-threshold 2',
    '--threads 2'
  ].join(' ')

  align_opts = '--threads 2'
  dedup_opts = '--threads 2 --lv-threshold 2'

  split_bam_opts = [
    '--bucket-threads 2',
    '--merge-threads 2',
    '--max-open-cb-writers 64',
    '--tag CB',
    '--filter-duplicates'
  ].join(' ')

  featurecounts_opts = '--threads 2 --batch-size 200 --extra "-g gene_id -t exon -s 1"'

  qc_metrics_opts = '--threads 2 --read-len-bin-width 100'
}
